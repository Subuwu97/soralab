# SoraLab by Mirai Creative Suite. With the Mirai suite, `npm run setup` in the mirai folder writes this file for you.
PORT=4800
PUBLIC_URL=http://localhost:4800
BRAND_NAME=Mirai

# Sign-in with Mirai Account (register with: node scripts/register-client.js --id soralab ... in mirai/accounts)
ACCOUNTS_URL=http://localhost:4000
CLIENT_ID=soralab
CLIENT_SECRET=
# Any long random string
SESSION_SECRET=

# Behind an HTTPS reverse proxy (Caddy etc.)
COOKIE_SECURE=false
TRUST_PROXY=false

# Suite features: Minami Cloud, Tsunami publishing, notifications. Leave empty to turn them off.
SUITE_SECRET=
CLOUD_URL=
PHOTOS_URL=
TSUNAMI_URL=

# Storage
# DATA_DIR=data
# MAX_UPLOAD_MB=4096
# MAX_DOC_MB=512
# STORAGE_GB_PER_USER=0
# VERSIONS_PER_DOC=50

# Rendering: auto, nvenc, qsv, amf, vaapi, videotoolbox or cpu
VIDEO_ENCODER=auto
# RENDER_JOBS=1
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
